<style>
  .lightbulb-trace path {
    fill: transparent;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linejoin: round;
    stroke-miterlimit: 1;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: lightbulb-draw 3s ease-out forwards;
    paint-order: stroke fill markers;
  }

  .lightbulb-trace path:nth-child(2) {
    animation-delay: 0.5s;
  }

  .lightbulb-trace path:nth-child(3) {
    animation-delay: 0.9s;
  }

  .lightbulb-trace path:nth-child(4) {
    animation-delay: 1.2s;
  }

  @keyframes lightbulb-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lightbulb-trace path {
      animation: none;
      stroke-dashoffset: 0;
    }
  }
</style>
