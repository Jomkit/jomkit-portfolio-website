---
import { Astronav, MenuItems, MenuIcon } from "astro-navbar";
import { Icon } from "astro-icon/components";
import { PRIMARY_NAV } from "../lib/navigation";
---

<header class="sticky top-0 z-10 w-full border-b border-blue-900/10 bg-blue-700 text-slate-100 shadow-sm dark:border-border dark:bg-card dark:text-card-foreground">
  <div class="mx-auto w-full px-6 lg:w-3/4 lg:px-16">
    <Astronav>
      <nav class="flex min-h-16 w-full items-center justify-between gap-6 text-xl">
        <h1 class="shrink-0 text-xl font-bold">
          <a class="block py-4" href="/">Jomkit Jujaroen</a>
        </h1>

        <div class="flex items-center gap-2 lg:hidden">
          <button
            type="button"
            class="theme-toggle inline-flex h-10 w-10 items-center justify-center rounded border border-white/25 text-slate-100 transition hover:bg-black/20 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
            aria-label="Switch to dark mode"
            aria-pressed="false"
            data-theme-toggle
          >
            <Icon name="bx:sun" class="theme-toggle__sun h-5 w-5" aria-hidden="true" />
            <Icon name="bx:moon" class="theme-toggle__moon hidden h-5 w-5" aria-hidden="true" />
          </button>
          <MenuIcon class="h-5 w-5 text-slate-100" />
        </div>

        <MenuItems class="hidden lg:flex lg:flex-1 lg:justify-end">
          <ul class="fixed left-0 top-16 flex w-screen flex-col bg-blue-700 text-center dark:bg-card lg:static lg:w-auto lg:flex-row lg:items-center lg:justify-end lg:text-start">
            {PRIMARY_NAV.map((link) => (
              <li><a class="nav-btn" href={link.href}>{link.label}</a></li>
            ))}
            <li class="hidden lg:flex lg:items-center lg:pl-2">
              <button
                type="button"
                class="theme-toggle inline-flex h-10 w-10 items-center justify-center rounded border border-white/25 text-slate-100 transition hover:bg-black/20 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent dark:text-card-foreground"
                aria-label="Switch to dark mode"
                aria-pressed="false"
                data-theme-toggle
              >
                <Icon name="bx:sun" class="theme-toggle__sun h-5 w-5" aria-hidden="true" />
                <Icon name="bx:moon" class="theme-toggle__moon hidden h-5 w-5" aria-hidden="true" />
              </button>
            </li>
          </ul>
        </MenuItems>
      </nav>
    </Astronav>
  </div>
</header>

<script is:inline>
  (() => {
    window.portfolioTheme?.applyTheme();
  })();
</script>

<style>
    li .nav-btn {
        @apply block w-full px-6 py-4 transition ease-in hover:bg-black hover:bg-opacity-25;
    }
</style>
