---
import { Astronav, MenuItems, MenuIcon } from "astro-navbar";
---

<header class="sticky top-0 z-10 w-full bg-blue-700 text-slate-100 shadow-sm">
  <div class="mx-auto w-full px-6 lg:w-3/4 lg:px-16">
    <Astronav>
      <nav class="flex min-h-16 w-full items-center justify-between gap-6 text-xl">
        <h1 class="shrink-0 text-xl font-bold">
          <a class="block py-4" href="/">Jomkit Jujaroen</a>
        </h1>

        <div class="block lg:hidden">
          <MenuIcon class="h-5 w-5 text-slate-100" />
        </div>

        <MenuItems class="hidden lg:flex lg:flex-1 lg:justify-end">
          <ul class="fixed left-0 top-16 flex w-screen flex-col bg-blue-700 text-center lg:static lg:w-auto lg:flex-row lg:justify-end lg:text-start">
            <li><a class="nav-btn" href="/">Home</a></li>
            <li><a class="nav-btn" href="/work">Work</a></li>
            <!-- <li><a class="nav-btn" href="/services">Services</a></li> -->
            <li><a class="nav-btn" href="/posts">Blog</a></li>
            <li><a class="nav-btn" href="/about">About</a></li>
            <li><a class="nav-btn" href="/resources">Resources</a></li>
            <li><a class="nav-btn" href="/contact">Contact</a></li>
          </ul>
        </MenuItems>
      </nav>
    </Astronav>
  </div>
</header>

<style>
    li .nav-btn {
        @apply block w-full px-6 py-4 transition ease-in hover:bg-black hover:bg-opacity-25;
    }
</style>
