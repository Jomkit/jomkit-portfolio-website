---
import Layout from "./Layout.astro";

const {frontmatter} = Astro.props;

const image = frontmatter.image;
const imageSrc = image?.src && image.src !== "Null" ? image.src : null;
const pubDate = new Date(frontmatter.pubDate);
const formattedDate = Number.isNaN(pubDate.getTime())
    ? frontmatter.pubDate
    : pubDate.toLocaleDateString("en-US", {
        year: "numeric",
        month: "long",
        day: "numeric",
    });
const datetime = Number.isNaN(pubDate.getTime()) ? undefined : pubDate.toISOString();
---
<Layout title={frontmatter.title} description={frontmatter.description}>
    <article class="w-full px-4 py-8">
        <header class="mx-auto flex w-full max-w-3xl flex-col gap-5">
            <a href="/posts" class="w-fit rounded bg-blue-700 px-3 py-2 text-base font-semibold text-white hover:bg-blue-800">Back to blog</a>
            <div class="space-y-3">
                <h1>{frontmatter.title}</h1>
                <p class="text-lg text-slate-600">{frontmatter.description}</p>
                <div class="flex flex-wrap gap-x-3 gap-y-1 text-base text-slate-500">
                    <span>{frontmatter.author}</span>
                    <span aria-hidden="true">/</span>
                    <time datetime={datetime}>{formattedDate}</time>
                </div>
            </div>

            {imageSrc && (
                <img
                    src={imageSrc}
                    alt={image?.alt ?? ""}
                    class="max-h-80 w-full rounded object-contain"
                    loading="eager"
                />
            )}
        </header>

        <div class="article-prose mt-8">
            <slot />
        </div>
    </article>
</Layout>
