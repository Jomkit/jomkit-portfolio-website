---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import ProjectOverlay from '../components/ProjectOverlay';
import Lightbulb from '@/components/Lightbulb.astro';
import { PROJECTS } from '../lib/projects';

interface Post {
	frontmatter: {
		title: string;
		pubDate: string;
		description?: string;
	};
	url: string;
}

const featuredProjects = PROJECTS
	.filter((project) => project.homeFeatured)
	.sort((a, b) => (a.homeFeaturedOrder ?? Number.MAX_SAFE_INTEGER) - (b.homeFeaturedOrder ?? Number.MAX_SAFE_INTEGER));
const latestPosts = Object.values(import.meta.glob<Post>('./posts/*.md', { eager: true }))
	.sort((a, b) => new Date(b.frontmatter.pubDate).getTime() - new Date(a.frontmatter.pubDate).getTime())
	.slice(0, 2);

const formatDate = (dateValue: string) => {
	const date = new Date(dateValue);

	if (Number.isNaN(date.getTime())) {
		return dateValue;
	}

	return date.toLocaleDateString('en-US', {
		year: 'numeric',
		month: 'short',
		day: 'numeric',
	});
};
---

<Layout title="Home">
	<section class="hero-section relative overflow-hidden bg-blue-800 text-white dark:bg-card dark:text-card-foreground">
		<div class="absolute inset-y-0 right-0 hidden w-1/3 bg-[radial-gradient(circle_at_top,rgba(255,255,255,0.16),transparent_58%)] lg:block"></div>
		<div class="relative grid items-center gap-8 lg:grid-cols-[minmax(0,1fr)_14rem]">
			<div class="space-y-6">
				<p class="text-sm uppercase tracking-[0.3em] text-blue-100 dark:text-muted-foreground">Full-Stack Software Engineer</p>
				<h1 class="fadeInDown">Jomkit Jujaroen</h1>
				<p class="max-w-2xl text-lg text-blue-50 dark:text-card-foreground">
					I build thoughtful product experiences across the stack, with a bias toward clear interfaces,
					maintainable systems, and websites that feel intentional.
				</p>
				<p class="max-w-2xl text-base text-blue-100/90 dark:text-muted-foreground">
					This portfolio is the best snapshot of how I think: real client work, shipped product contributions,
					and the writing I use to sharpen my engineering judgment.
				</p>
				<div class="flex flex-wrap gap-3">
					<a class="cta-primary" href="/work">See My Work</a>
					<a class="cta-secondary" href="/contact">Get In Touch</a>
				</div>
			</div>
			<div class="mx-auto w-36 lg:w-full">
				<Lightbulb />
			</div>
		</div>
	</section>

	<section class="bg-slate-100 dark:bg-muted">
		<div class="section-heading">
			<p class="eyebrow">Featured Work</p>
			<h2>Selected projects with real product and client impact</h2>
			<p>
				A few representative projects from product engineering and bespoke web work. The full portfolio lives
				on the Work page.
			</p>
		</div>
		<div class="grid gap-6 lg:grid-cols-3">
			{featuredProjects.map((project) => (
				<div class="flex h-full flex-col space-y-4 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm dark:border-border dark:bg-card">
					{project.image && (
						<ProjectOverlay
							header={project.homeOverlayTitle ?? project.title}
							footer={project.homeOverlayBody ?? project.summary}
							url={project.externalUrl}
							client:load
						>
							<Image src={project.image} alt={project.imageAlt ?? project.title} class="rounded-xl" />
						</ProjectOverlay>
					)}
					<div class="flex flex-1 flex-col space-y-3">
						<div class="flex flex-col gap-1">
							<p class="text-sm uppercase tracking-[0.2em] text-slate-500 dark:text-muted-foreground">{project.scope}</p>
							<h3 class="font-semibold text-blue-800 dark:text-primary">{project.title}</h3>
							<p class="text-sm text-slate-500 dark:text-muted-foreground">{project.role} | {project.period}</p>
						</div>
						<p>{project.summary}</p>
						<div class="flex flex-wrap gap-2">
							{project.technologies.map((technology) => (
								<span class="rounded-full bg-slate-100 px-3 py-1 text-sm font-medium text-slate-700 dark:bg-background dark:text-muted-foreground">
									{technology}
								</span>
							))}
						</div>
					</div>
				</div>
			))}
		</div>
		<a class="inline-flex w-fit rounded-full border border-blue-800 px-4 py-2 text-sm font-semibold text-blue-800 transition hover:bg-blue-800 hover:text-white dark:border-primary dark:text-primary dark:hover:bg-primary dark:hover:text-primary-foreground" href="/work">
			View the full portfolio
		</a>
	</section>

	<section class="bg-white dark:bg-background">
		<div class="section-heading">
			<p class="eyebrow">What I Do</p>
			<h2>Build clear product experiences across UI, content, and implementation</h2>
		</div>
		<div class="grid gap-4 md:grid-cols-3">
			<div class="rounded-2xl border border-slate-200 bg-slate-50 p-5 dark:border-border dark:bg-card">
				<h3 class="font-semibold">Product-facing engineering</h3>
				<p class="mt-2">
					I like work that sits close to real users: features, flows, and interfaces that need to hold up
					under actual product pressure.
				</p>
			</div>
			<div class="rounded-2xl border border-slate-200 bg-slate-50 p-5 dark:border-border dark:bg-card">
				<h3 class="font-semibold">Intentional front-end structure</h3>
				<p class="mt-2">
					I care about hierarchy, maintainability, and choosing abstractions that make future changes easier
					instead of noisier.
				</p>
			</div>
			<div class="rounded-2xl border border-slate-200 bg-slate-50 p-5 dark:border-border dark:bg-card">
				<h3 class="font-semibold">Curiosity as leverage</h3>
				<p class="mt-2">
					My writing and side projects usually start with a technical question and turn into a sharper point
					of view about tools, systems, and engineering tradeoffs.
				</p>
			</div>
		</div>
	</section>

	<section class="bg-slate-100 dark:bg-muted">
		<div class="section-heading">
			<p class="eyebrow">Current Focus</p>
			<h2>Recent writing and what I am learning right now</h2>
			<p>
				I use the blog as a place to think through engineering decisions, learning experiments, and tool
				tradeoffs.
			</p>
		</div>
		<div class="grid gap-4 lg:grid-cols-2">
			{latestPosts.map((post) => (
				<a class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md dark:border-border dark:bg-card" href={post.url}>
					<p class="text-sm uppercase tracking-[0.2em] text-slate-500 dark:text-muted-foreground">{formatDate(post.frontmatter.pubDate)}</p>
					<h3 class="mt-3 font-semibold text-blue-800 dark:text-primary">{post.frontmatter.title}</h3>
					<p class="mt-2 text-slate-700 dark:text-card-foreground">{post.frontmatter.description}</p>
				</a>
			))}
		</div>
		<a class="inline-flex w-fit rounded-full border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700 transition hover:border-blue-800 hover:text-blue-800 dark:border-border dark:text-card-foreground dark:hover:border-primary dark:hover:text-primary" href="/posts">
			Read more writing
		</a>
	</section>

	<section class="bg-white dark:bg-background">
		<div class="section-heading">
			<p class="eyebrow">About</p>
			<h2>A little more context behind how I work</h2>
		</div>
		<div class="grid gap-6 lg:grid-cols-[minmax(0,1.2fr)_minmax(0,0.8fr)]">
			<div class="space-y-4">
				<p>
					I am a software developer based in Maine with a background that crosses engineering, design-minded
					web work, and a habit of learning in public.
				</p>
				<p>
					My broader interests are part of the point, not a distraction. I like building taste and judgment by
					exploring adjacent disciplines, which is also why Hobbies stays as its own secondary page.
				</p>
			</div>
			<div class="rounded-2xl border border-slate-200 bg-slate-50 p-5 dark:border-border dark:bg-card">
				<h3 class="font-semibold">Continue exploring</h3>
				<div class="mt-4 flex flex-col gap-3">
					<a class="text-blue-800 underline underline-offset-4 dark:text-primary" href="/about">Read the full About page</a>
					<a class="text-blue-800 underline underline-offset-4 dark:text-primary" href="/about/hobbies">See the Hobbies page</a>
				</div>
			</div>
		</div>
	</section>

	<section class="bg-blue-800 text-white dark:bg-card dark:text-card-foreground">
		<div class="section-heading">
			<p class="eyebrow text-blue-100 dark:text-muted-foreground">Contact</p>
			<h2>Looking for a builder who cares about the details</h2>
			<p class="text-blue-100 dark:text-muted-foreground">
				I am open to conversations about product features, portfolio websites, and collaboration where the
				work benefits from strong implementation judgment and a careful front-end eye.
			</p>
		</div>
		<div class="flex flex-wrap gap-3">
			<a class="cta-primary-inverse" href="/contact">Start the conversation</a>
			<a class="cta-secondary-inverse" href="mailto:j.jujaroen96@gmail.com">Email me directly</a>
		</div>
	</section>
</Layout>

<style>
	.hero-section {
		@apply min-h-[32rem];
	}

	@keyframes fadeInDown {
		0% {
			transform: translateY(-100%);
			opacity: 0;
		}
		100% {
			transform: translateY(0%);
			opacity: 1;
		}
	}

	.fadeInDown {
		animation: 1.5s fadeInDown;
	}

	.section-heading {
		@apply max-w-3xl space-y-3;
	}

	.eyebrow {
		@apply text-sm uppercase tracking-[0.3em] text-slate-500 dark:text-muted-foreground;
	}

	.cta-primary {
		@apply inline-flex rounded-full bg-white px-5 py-3 text-sm font-semibold text-blue-800 transition hover:bg-blue-100;
	}

	.cta-secondary {
		@apply inline-flex rounded-full border border-white/40 px-5 py-3 text-sm font-semibold text-white transition hover:bg-white/10;
	}

	.cta-primary-inverse {
		@apply inline-flex rounded-full bg-white px-5 py-3 text-sm font-semibold text-blue-800 transition hover:bg-blue-100 dark:bg-primary dark:text-primary-foreground dark:hover:bg-accent;
	}

	.cta-secondary-inverse {
		@apply inline-flex rounded-full border border-white/40 px-5 py-3 text-sm font-semibold text-white transition hover:bg-white/10 dark:border-border dark:text-card-foreground dark:hover:bg-background;
	}
</style>
