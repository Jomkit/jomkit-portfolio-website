---
import Layout from '../../layouts/Layout.astro';
import ProjectOverlay from '../../components/ProjectOverlay';
import { Image } from 'astro:assets';
import { PROJECTS } from '../../lib/projects';

const professionalProjects = PROJECTS.filter((project) => project.scope === 'professional');
const personalProjects = PROJECTS.filter((project) => project.scope === 'personal');
---

<Layout title="Work">
    <section class="bg-blue-800 text-white dark:bg-card dark:text-card-foreground">
        <div class="section-heading">
            <p class="eyebrow text-blue-100 dark:text-muted-foreground">Work</p>
            <h1>Selected work across product engineering and bespoke websites</h1>
            <p class="max-w-3xl text-lg text-blue-100 dark:text-muted-foreground">
                This page is the canonical view of my project experience. It combines client work, product-facing
                engineering, and personal builds that show how I think through implementation and presentation.
            </p>
        </div>
    </section>

    <section class="bg-white dark:bg-background">
        <div class="section-heading">
            <p class="eyebrow">Professional Work</p>
            <h2>Client and product work with clear ownership</h2>
        </div>

        <div class="grid gap-6">
            {professionalProjects.map((project) => (
                <article class="grid gap-6 rounded-2xl border border-slate-200 bg-slate-50 p-5 shadow-sm dark:border-border dark:bg-card lg:grid-cols-[minmax(0,1.2fr)_minmax(0,0.8fr)]">
                    <div class="space-y-4">
                        <div>
                            <p class="text-sm uppercase tracking-[0.2em] text-slate-500 dark:text-muted-foreground">{project.period}</p>
                            <h3 class="mt-2 font-semibold text-blue-800 dark:text-primary">{project.title}</h3>
                            <p class="text-lg">{project.role}</p>
                        </div>
                        <p>{project.summary}</p>
                        <div class="flex flex-wrap gap-2">
                            {project.technologies.map((technology) => (
                                <span class="rounded-full bg-white px-3 py-1 text-sm font-medium text-slate-700 dark:bg-background dark:text-muted-foreground">
                                    {technology}
                                </span>
                            ))}
                        </div>
                        {project.externalUrl && (
                            <a class="inline-flex rounded-full border border-blue-800 px-4 py-2 text-sm font-semibold text-blue-800 transition hover:bg-blue-800 hover:text-white dark:border-primary dark:text-primary dark:hover:bg-primary dark:hover:text-primary-foreground" href={project.externalUrl} target="_blank" rel="noopener noreferrer">
                                Visit project
                            </a>
                        )}
                    </div>
                    <div>
                        {project.image && (
                            <ProjectOverlay header={project.homeOverlayTitle ?? project.title} footer={project.homeOverlayBody ?? project.summary} url={project.externalUrl} client:load>
                                <Image src={project.image} alt={project.imageAlt ?? project.title} class="rounded-xl" />
                            </ProjectOverlay>
                        )}
                    </div>
                </article>
            ))}
        </div>
    </section>

    <section class="bg-slate-100 dark:bg-muted dark:text-foreground">
        <div class="section-heading">
            <p class="eyebrow">Personal Projects</p>
            <h2>Projects I use to sharpen product and engineering judgment</h2>
        </div>

        <div class="grid gap-4 lg:grid-cols-2">
            {personalProjects.map((project) => (
                <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-border dark:bg-card">
                    <p class="text-sm uppercase tracking-[0.2em] text-slate-500 dark:text-muted-foreground">{project.period}</p>
                    <h3 class="mt-2 font-semibold text-blue-800 dark:text-primary">{project.title}</h3>
                    <p class="mt-1 text-base">{project.role}</p>
                    <p class="mt-4">{project.summary}</p>
                    <div class="mt-4 flex flex-wrap gap-2">
                        {project.technologies.map((technology) => (
                            <span class="rounded-full bg-slate-100 px-3 py-1 text-sm font-medium text-slate-700 dark:bg-background dark:text-muted-foreground">
                                {technology}
                            </span>
                        ))}
                    </div>
                </article>
            ))}
        </div>
    </section>

    <section class="bg-white dark:bg-background">
        <div class="section-heading">
            <p class="eyebrow">How I Work</p>
            <h2>Clear structure, sharp communication, and maintainable execution</h2>
            <p>
                I do my best work where product thinking, implementation quality, and interface clarity all matter at
                the same time.
            </p>
        </div>
        <div class="grid gap-4 md:grid-cols-3">
            <div class="rounded-2xl border border-slate-200 bg-slate-50 p-5 dark:border-border dark:bg-card">
                <h3 class="font-semibold">Understand the real constraint</h3>
                <p class="mt-2">I like tracing problems to the actual ownership seam before changing code or UI.</p>
            </div>
            <div class="rounded-2xl border border-slate-200 bg-slate-50 p-5 dark:border-border dark:bg-card">
                <h3 class="font-semibold">Keep the solution coherent</h3>
                <p class="mt-2">I prefer one clear path over scattered fixes that work individually but drift together.</p>
            </div>
            <div class="rounded-2xl border border-slate-200 bg-slate-50 p-5 dark:border-border dark:bg-card">
                <h3 class="font-semibold">Build for the next change</h3>
                <p class="mt-2">I care about leaving behind a structure that makes the next iteration easier to trust.</p>
            </div>
        </div>
    </section>

    <section class="bg-blue-800 text-white dark:bg-card dark:text-card-foreground">
        <div class="section-heading">
            <p class="eyebrow text-blue-100 dark:text-muted-foreground">Contact</p>
            <h2>Interested in working together</h2>
            <p class="text-blue-100 dark:text-muted-foreground">
                If you are looking for someone who can think through both product details and implementation seams, I
                would be glad to connect.
            </p>
        </div>
        <a class="inline-flex w-fit rounded-full bg-white px-5 py-3 text-sm font-semibold text-blue-800 transition hover:bg-blue-100 dark:bg-primary dark:text-primary-foreground dark:hover:bg-accent" href="/contact">
            Contact me
        </a>
    </section>
</Layout>

<style>
    .section-heading {
        @apply max-w-3xl space-y-3;
    }

    .eyebrow {
        @apply text-sm uppercase tracking-[0.3em] text-slate-500 dark:text-muted-foreground;
    }
</style>
