---
import Layout from "../../layouts/Layout.astro";
const email = "j.jujaroen96@gmail.com";
const linkedInUrl = "https://www.linkedin.com/in/jomkit-jujaroen/";
const github = "https://github.com/Jomkit";
---
<Layout title="Contact">
    <section class="bg-blue-800 text-white dark:bg-card dark:text-card-foreground">
        <div class="mx-auto max-w-3xl space-y-4">
            <p class="text-sm uppercase tracking-[0.3em] text-blue-100 dark:text-muted-foreground">Contact</p>
            <h1>Let's connect</h1>
            <p class="text-lg text-blue-100 dark:text-muted-foreground">
                If you have a project, product problem, or website idea that would benefit from careful implementation
                and clear presentation, email is the best place to start.
            </p>
        </div>
    </section>

    <section class="bg-white dark:bg-background">
        <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,0.8fr)]">
            <div class="rounded-2xl border border-slate-200 bg-slate-50 p-6 dark:border-border dark:bg-card">
                <h2>Preferred contact path</h2>
                <p class="mt-3">
                    The easiest way to reach me is by email. Include a few lines about what you are building or what
                    kind of help you need, and I can respond with the most useful next step.
                </p>
                <a class="mt-5 inline-flex rounded-full bg-blue-800 px-5 py-3 text-sm font-semibold text-white transition hover:bg-blue-900 dark:bg-primary dark:text-primary-foreground dark:hover:bg-accent" href={`mailto:${email}`}>
                    Email {email}
                </a>
            </div>
            <div class="rounded-2xl border border-slate-200 bg-slate-50 p-6 dark:border-border dark:bg-card">
                <h2>Other places</h2>
                <div class="mt-4 space-y-3">
                    <p>LinkedIn: <a class="underline" href={linkedInUrl} target="_blank" rel="noopener noreferrer">{linkedInUrl}</a></p>
                    <p>GitHub: <a class="underline" href={github} target="_blank" rel="noopener noreferrer">{github}</a></p>
                </div>
            </div>
        </div>
    </section>
</Layout>
